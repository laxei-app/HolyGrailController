<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- マルチキャスト(SSDP)に必要な場合がある -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- APモードのエッジ(インターネット無し)へ接続を要求・維持し、通信をそのNICへバインドする(§1.2.1) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- 撮影場所の「現在地を取得」(§7.9)。粗い測位も許可 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ログ取得: API28以下で公開Downloadsへ書き込む(29+はMediaStoreで権限不要) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- エッジ設定QR(PoP)スキャン §8.2.2 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- エッジ設定 BLEプロビジョニング §8.2 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- BLE(<31)と撮影場所の現在地取得(§7.9)の両方で使うためSDK上限なし -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HolyGrail">

        <!-- GMSコードスキャナ(QR)モジュールをインストール時に取得 §8.2.2 -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name="app.laxei.holygrail.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 買ってきたエッジ端末へ USB でファームを書き込む画面。
             新品には自分たちのファームが入っていないため OTA では焼けず、ここが唯一の道。
             USB_DEVICE_ATTACHED を受けるのは、挿したときに権限を貰っておくため。
             端末の PID は状態で変わる(工場出荷=8120 / ダウンロードモード・本体=1001)ので、
             device_filter.xml に両方を並べてある。 -->
        <!-- singleTop にしておくこと。書き込みの途中で端末はダウンロードモードへ入るために
             再起動し、そのたびに USB が出直す。標準の起動方法だと画面が作り直され、
             経過の記録が消えて何が起きたのか追えなくなる(実機で踏んだ)。 -->
        <activity
            android:name="app.laxei.holygrail.EdgeFlashActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
    </application>
</manifest>
