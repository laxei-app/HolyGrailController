<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- マルチキャスト(SSDP)に必要な場合がある -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- APモードのエッジ(インターネット無し)へ接続を要求・維持し、通信をそのNICへバインドする(§1.2.1) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- 撮影場所の「現在地を取得」(§7.9)。粗い測位も許可 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ログ取得: API28以下で公開Downloadsへ書き込む(29+はMediaStoreで権限不要) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- エッジ設定QR(PoP)スキャン §8.2.2 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- エッジ設定 BLEプロビジョニング §8.2 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- BLE(<31)と撮影場所の現在地取得(§7.9)の両方で使うためSDK上限なし -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- 「権限、端末設定」画面から電池の最適化の対象外を頼む(2026-09-21)。長時間の撮影を前面で続けるため -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 【広告IDは集めない(2026-09-27)】Firebase の計測ライブラリは既定でこれを集め、
         AD_ID 権限もここへ勝手に足してくる。広告は出さないので使い道が無く、集めると
         Play の「データ安全性」の申告項目が増えるだけ。収集を止め、権限も外す。
         広告を出す段になったら、この2つを消せば元に戻る。 -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!-- 上と同じ用途の Privacy Sandbox 側の権限。計測ライブラリが勝手に足してくるが、
         広告IDを使わないので要らない。無い端末でも SDK は動くようになっている。 -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TwyLapse">

        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />

        <!-- 【同意を貰うまで集めない(2026-09-27 依頼)】Firebase は ContentProvider で
             MainActivity.onCreate より先に動き出すので、実行時の applyTelemetryConsent() だけでは
             最初の1回(first_open など)が答えを聞く前に出てしまう。既定を off にしておき、
             「送る」と答えたときだけ実行時に on にする。
             _deactivated ではなく _enabled を使うこと(前者は実行時に戻せない)。 -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />

        <!-- GMSコードスキャナ(QR)モジュールをインストール時に取得 §8.2.2 -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- 回転(縦⇄横)で画面を作り直させない(2026-08-30 UI依頼)。
             作り直されると onCreate が最初から走り、開いていた画面が撮影計画へ戻ってしまう
             (ネイティブ初期化・常駐スレッド・プレゼンス開始までやり直しになる)。
             configChanges を宣言し、幅に依存する所だけ onConfigurationChanged で組み直す。 -->
        <activity
            android:name="app.laxei.twylapse.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 「出荷時設定に戻す」のあとアプリを開き直すためだけの画面(2026-09-05 UI依頼)。
             **別プロセスに置くことが要点**。本体プロセスを落としてから開き直す役なので、
             同じプロセスだと自分も巻き込まれて何も起動できない。
             ランチャーには出さない(exported=false・intent-filter なし)。 -->
        <activity
            android:name="app.laxei.twylapse.RestartActivity"
            android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- 買ってきたエッジ端末へ USB でファームを書き込む画面。
             新品には自分たちのファームが入っていないため OTA では焼けず、ここが唯一の道。
             USB_DEVICE_ATTACHED を受けるのは、挿したときに権限を貰っておくため。
             端末の PID は状態で変わる(工場出荷=8120 / ダウンロードモード・本体=1001)ので、
             device_filter.xml に両方を並べてある。 -->
        <!-- singleTop にしておくこと。書き込みの途中で端末はダウンロードモードへ入るために
             再起動し、そのたびに USB が出直す。標準の起動方法だと画面が作り直され、
             経過の記録が消えて何が起きたのか追えなくなる(実機で踏んだ)。 -->
        <activity
            android:name="app.laxei.twylapse.EdgeFlashActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
    </application>
</manifest>
