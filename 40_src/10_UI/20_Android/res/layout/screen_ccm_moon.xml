<?xml version="1.0" encoding="utf-8"?>
<!-- 月の影響への対処の初期値(仕様書10 §7.4 / §3.6)。対処方法で項目を出し分ける。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/moon_header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#1565C0"
        android:gravity="center_vertical" android:padding="8dp">
        <ImageView android:id="@+id/moon_back" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_back" />
        <TextView android:id="@+id/moon_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="月の影響への対処" android:textColor="#FFFFFF"
            android:textSize="18sp" android:textStyle="bold" />
        <View android:layout_width="32dp" android:layout_height="32dp" />
    </LinearLayout>

    <ScrollView android:id="@+id/moon_presetScroll"
        android:layout_width="match_parent" android:layout_height="110dp">
        <LinearLayout android:id="@+id/moon_presetList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="6dp" />
    </ScrollView>
    <FrameLayout android:id="@+id/moon_presetDivider"
        android:layout_width="match_parent" android:layout_height="26dp"
        android:background="#ECEFF1" android:clickable="true" android:focusable="true">
        <View android:layout_width="48dp" android:layout_height="5dp" android:layout_gravity="center"
            android:background="@drawable/divider_handle" />
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/moon_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">

            <!-- 色(システム共通へ移行。色はメニュー「色の設定」で設定する) -->
            <LinearLayout android:id="@+id/moon_color_row" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="色の設定" android:textStyle="bold" />
                <View android:id="@+id/moon_color_swatch" android:layout_width="40dp" android:layout_height="28dp" android:background="#888888" />
                <Button android:id="@+id/moon_color_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="変更" />
            </LinearLayout>

            <!-- 対処方法 -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="対処方法" android:textStyle="bold" />
            <Spinner android:id="@+id/moon_mode" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <!-- 自動補正(autoBrightness)。輝度・evスライダーは明暗バー下地・つまみ月・値はセンター。 -->
            <LinearLayout android:id="@+id/moon_auto_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="補正を開始する撮影対象の輝度" android:textStyle="bold" />
                <TextView android:id="@+id/moon_startlum_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:text="+2.0ev" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
                    <View android:layout_width="match_parent" android:layout_height="12dp" android:layout_gravity="center_vertical" android:background="@drawable/brightness_bar" />
                    <com.google.android.material.slider.Slider android:id="@+id/moon_startlum_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#888888" android:text="夜間撮影時の輝度を0evとして補正を開始する輝度(0〜+3ev)" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="露出補正(ev)" android:textStyle="bold" />
                <TextView android:id="@+id/moon_ev_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:text="-3.0ev" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
                    <View android:layout_width="match_parent" android:layout_height="12dp" android:layout_gravity="center_vertical" android:background="@drawable/brightness_bar" />
                    <com.google.android.material.slider.Slider android:id="@+id/moon_ev_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#888888" android:text="近づける露出補正値(0〜-10ev)" />
            </LinearLayout>

            <!-- 月に露出を合わせる(moonExposure) -->
            <LinearLayout android:id="@+id/moon_exp_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="開始時露出" android:textStyle="bold" />
                <LinearLayout android:id="@+id/moon_init_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <CheckBox android:id="@+id/moon_atmext" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="大気消光補正をおこなう" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="大気消光係数" />
                    <TextView android:id="@+id/moon_extcoef_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.20" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/moon_extcoef_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <CheckBox android:id="@+id/moon_geocorr" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="地心距離補正をおこなう" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="空の明るさ補正係数" />
                    <TextView android:id="@+id/moon_skycoef_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" />
                </LinearLayout>
                <com.google.android.material.slider.Slider android:id="@+id/moon_skycoef_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 月撮影時露出限界: 暗所側=夜間値でグレー●固定(左に動かせない)、明所側=月。値は明所限界のみ。左の⇅で並べ替え。 -->
            <LinearLayout android:id="@+id/moon_limit_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="月撮影時露出限界" android:textStyle="bold" />
                <LinearLayout android:id="@+id/moon_limit_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="11sp" android:textColor="#888888"
                    android:text="ISO感度、F値、シャッター速度は左の⇅で上下に移動できます。一番上の項目が限界に達すると中段の項目を変更します。さらに中段の項目も限界になると最下段の項目で調整します。暗所側(グレー)は夜間撮影の設定値で固定です。" />
            </LinearLayout>

            <Button android:id="@+id/moon_save" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="保存" android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
