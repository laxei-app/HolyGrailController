<?xml version="1.0" encoding="utf-8"?>
<!-- 602.色の設定。撮影制御方法ごとに文字色/背景色をカラーピッカーで設定(システム共通)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/color_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageView android:id="@+id/color_home" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_home_r" />
        <TextView android:id="@+id/color_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="色の設定" android:textColor="#FFFFFF"
            android:textSize="20sp" android:textStyle="bold" />
        <!-- 右上のメニューは廃止(2026-08-29 UI依頼)。題が中央に見えるよう幅だけ残す -->
        <ImageView android:id="@+id/color_menu" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_menu_r" />
    </LinearLayout>

    <!-- ページ/型のタブ(2026-09-07 UI依頼)。スワイプは残し、どのページがあるかを見せてタップでも移動できるようにする。 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/color_tabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#E3F2FD"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabMinWidth="72dp"
        app:tabTextColor="#455A64"
        app:tabSelectedTextColor="#0D47A1"
        app:tabIndicatorColor="#1565C0"
        app:tabIndicatorHeight="3dp" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/color_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp" />
    </ScrollView>
</LinearLayout>
