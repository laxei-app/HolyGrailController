<?xml version="1.0" encoding="utf-8"?>
<!-- 630.レンズリスト(所持レンズ)。一覧表示・削除。新規追加で 632 へ。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageView android:id="@+id/lenslist_back" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="所持レンズ" android:textColor="#FFFFFF"
            android:textSize="20sp" android:textStyle="bold" />
        <View android:layout_width="32dp" android:layout_height="32dp" />
    </LinearLayout>

    <Button android:id="@+id/lenslist_add" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="12dp" android:text="＋ 新規レンズ追加" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/lenslist_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp" />
    </ScrollView>
</LinearLayout>
