<?xml version="1.0" encoding="utf-8"?>
<!-- 撮影制御方法ごとの初期値編集(仕様書10 §7.4)。方法に応じてセクションを出し分ける。
     太陽高度・ev はスライダー、露出/露出限界はキーボード入力、色はピッカー。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageView android:id="@+id/edit_back" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_back" />
        <TextView android:id="@+id/edit_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="撮影制御方法" android:textColor="#FFFFFF"
            android:textSize="20sp" android:textStyle="bold" />
        <View android:layout_width="32dp" android:layout_height="32dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 色の設定 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="色の設定" android:textStyle="bold" />
                <View android:id="@+id/edit_color_swatch" android:layout_width="40dp" android:layout_height="28dp" android:background="#888888" />
                <Button android:id="@+id/edit_color_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="変更" />
            </LinearLayout>

            <!-- 太陽高度(スライダー) -->
            <LinearLayout android:id="@+id/edit_alt_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="固定露出/薄明 太陽高度" android:textStyle="bold" />
                    <TextView android:id="@+id/edit_alt_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-18.0°" />
                </LinearLayout>
                <SeekBar android:id="@+id/edit_alt_seek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="140" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#888888" android:text="-19°(天文薄明) 〜 -5°(市民薄明)" />
            </LinearLayout>

            <!-- 露出補正 ev(スライダー) -->
            <LinearLayout android:id="@+id/edit_ev_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="露出補正 ev" android:textStyle="bold" />
                    <TextView android:id="@+id/edit_ev_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-3.0" />
                </LinearLayout>
                <SeekBar android:id="@+id/edit_ev_seek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="30" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#888888" android:text="-5.0 〜 +5.0 (1/3段)" />
            </LinearLayout>

            <!-- 曇り空 自動判別(夜間) -->
            <CheckBox android:id="@+id/edit_autoEdge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="曇り空など空が暗い時は自動判別する" />

            <!-- 固定露出(夜間) -->
            <LinearLayout android:id="@+id/edit_fixed_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="固定露出" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="ISO" android:gravity="center_vertical" />
                    <EditText android:id="@+id/edit_fix_iso" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" />
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="SS" android:gravity="center" />
                    <EditText android:id="@+id/edit_fix_ss" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="F" android:gravity="center" />
                    <EditText android:id="@+id/edit_fix_fn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <!-- 露出限界(自動露出) -->
            <LinearLayout android:id="@+id/edit_limit_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="露出限界" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="明るい側(上限)" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="ISO" android:gravity="center_vertical" />
                    <EditText android:id="@+id/edit_lb_iso" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" />
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="SS" android:gravity="center" />
                    <EditText android:id="@+id/edit_lb_ss" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="F" android:gravity="center" />
                    <EditText android:id="@+id/edit_lb_fn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="暗い側(下限)" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="ISO" android:gravity="center_vertical" />
                    <EditText android:id="@+id/edit_ld_iso" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" />
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="SS" android:gravity="center" />
                    <EditText android:id="@+id/edit_ld_ss" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="F" android:gravity="center" />
                    <EditText android:id="@+id/edit_ld_fn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/edit_save" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="保存" android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
