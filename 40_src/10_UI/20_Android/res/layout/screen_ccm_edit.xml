<?xml version="1.0" encoding="utf-8"?>
<!-- 撮影制御方法ごとの初期値編集(仕様書10 §7.4)。方法に応じてセクションを出し分ける。
     太陽高度・ev はスライダー、露出/露出限界はキーボード入力、色はピッカー。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/edit_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageView android:id="@+id/edit_back" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_back" />
        <TextView android:id="@+id/edit_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="撮影制御方法" android:textColor="#FFFFFF"
            android:textSize="20sp" android:textStyle="bold" />
        <View android:layout_width="32dp" android:layout_height="32dp" />
    </LinearLayout>

    <!-- 初期値プリセット一覧(初期値編集時のみ表示。計画固有編集時は非表示) -->
    <ScrollView android:id="@+id/edit_presetScroll"
        android:layout_width="match_parent" android:layout_height="110dp">
        <LinearLayout android:id="@+id/edit_presetList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="6dp" />
    </ScrollView>
    <FrameLayout android:id="@+id/edit_presetDivider"
        android:layout_width="match_parent" android:layout_height="26dp"
        android:background="#ECEFF1" android:clickable="true" android:focusable="true">
        <View android:layout_width="48dp" android:layout_height="5dp" android:layout_gravity="center"
            android:background="@drawable/divider_handle" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout android:id="@+id/edit_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 色の設定(システム共通へ移行。色はメニュー「色の設定」で設定する) -->
            <LinearLayout android:id="@+id/edit_color_row" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="色の設定" android:textStyle="bold" />
                <View android:id="@+id/edit_color_swatch" android:layout_width="40dp" android:layout_height="28dp" android:background="#888888" />
                <Button android:id="@+id/edit_color_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="変更" />
            </LinearLayout>

            <!-- 太陽高度(スライダー)。明暗バー下地・つまみ●・値はセンター。薄明帯ラベルはコードで生成。 -->
            <LinearLayout android:id="@+id/edit_alt_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <TextView android:id="@+id/edit_alt_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:fontFamily="monospace" android:textSize="12sp" android:textColor="#1565C0" android:text="" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/edit_alt_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:text="固定露出太陽高度" android:textStyle="bold" />
                    <TextView android:id="@+id/edit_alt_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:text="-18°" />
                    <TextView android:id="@+id/edit_alt_end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical" android:fontFamily="monospace" android:textSize="12sp" android:textColor="#1565C0" android:text="" />
                </FrameLayout>
                <LinearLayout android:id="@+id/edit_alt_bands" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
                    <View android:id="@+id/edit_alt_bar" android:layout_width="match_parent" android:layout_height="12dp" android:layout_gravity="center_vertical" android:background="@drawable/brightness_bar" />
                    <com.google.android.material.slider.Slider android:id="@+id/edit_alt_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.google.android.material.slider.RangeSlider android:id="@+id/edit_alt_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- 露出補正(ev)(スライダー)。タイトルと値は同一行(左:タイトル/右:値)。 -->
            <LinearLayout android:id="@+id/edit_ev_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:text="露出補正(ev)" android:textStyle="bold" />
                    <TextView android:id="@+id/edit_ev_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:text="-3.0" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
                    <View android:layout_width="match_parent" android:layout_height="12dp" android:layout_gravity="center_vertical" android:background="@drawable/brightness_bar" />
                    <com.google.android.material.slider.Slider android:id="@+id/edit_ev_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </FrameLayout>
            </LinearLayout>

            <!-- 曇り空 自動判別(夜間) -->
            <CheckBox android:id="@+id/edit_autoEdge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="曇り空など空が暗い時は自動判別する" />

            <!-- 固定露出(夜間) -->
            <LinearLayout android:id="@+id/edit_fixed_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="固定露出" android:textStyle="bold" />
                <LinearLayout android:id="@+id/edit_fix_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>

            <!-- 夜間前露出補正(夜間)。夜間前移行(自動露出→夜間)の目標露出補正(ev)。時間的に夜間後より前なので先に表示。 -->
            <LinearLayout android:id="@+id/edit_preev_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:text="夜間前露出補正(ev)" android:textStyle="bold" />
                    <TextView android:id="@+id/edit_preev_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:text="+0.0" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
                    <View android:layout_width="match_parent" android:layout_height="12dp" android:layout_gravity="center_vertical" android:background="@drawable/brightness_bar" />
                    <com.google.android.material.slider.Slider android:id="@+id/edit_preev_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </FrameLayout>
            </LinearLayout>

            <!-- 夜間後露出補正(夜間)。タイトルと値は同一行(左:タイトル/右:値)。 -->
            <LinearLayout android:id="@+id/edit_postev_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:text="夜間後露出補正(ev)" android:textStyle="bold" />
                    <TextView android:id="@+id/edit_postev_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:text="+0.0" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
                    <View android:layout_width="match_parent" android:layout_height="12dp" android:layout_gravity="center_vertical" android:background="@drawable/brightness_bar" />
                    <com.google.android.material.slider.Slider android:id="@+id/edit_postev_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </FrameLayout>
            </LinearLayout>

            <!-- 露出平滑化(朝日/夕日のみ。この撮影制御方法に個別のヒステリシス/移動平均)。 -->
            <LinearLayout android:id="@+id/edit_smooth_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="露出平滑化(この撮影)" android:textStyle="bold" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:text="ヒステリシス" />
                    <TextView android:id="@+id/edit_hyst_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:text="0.3ev" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
                    <com.google.android.material.slider.Slider android:id="@+id/edit_hyst_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:text="移動平均フレーム数" />
                    <TextView android:id="@+id/edit_ma_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:text="3frame" />
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp">
                    <com.google.android.material.slider.Slider android:id="@+id/edit_ma_seek" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="11sp" android:textColor="#888888"
                    android:text="朝日/夕日だけ個別に平滑化を設定できます。ヒステリシスを広く・移動平均を多くすると露出変化はなめらかになりますが明るさ変化への追従は遅くなります。" />
            </LinearLayout>

            <!-- 露出限界、範囲: 項目ごとに暗所限界〜明所限界の範囲スライダー。左の⇅で並べ替え。 -->
            <LinearLayout android:id="@+id/edit_limit_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="露出限界、範囲" android:textStyle="bold" />
                <LinearLayout android:id="@+id/edit_limit_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="11sp" android:textColor="#888888"
                    android:text="ISO感度、F値、シャッター速度は左の⇅で上下に移動できます。露出補正の際に最初に上の項目を変更して調整します。一番上の項目が限界に達すると中段の項目を変更します。さらに中段の項目も限界になると最下段の項目で調整します。" />
            </LinearLayout>

            <Button android:id="@+id/edit_save" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="保存" android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
