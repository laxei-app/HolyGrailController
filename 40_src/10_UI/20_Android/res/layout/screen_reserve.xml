<?xml version="1.0" encoding="utf-8"?>
<!-- 650.カメラ予約表(項目17)。カメラごとに帯を出し、その下に「開始-終了 端末名 計画名」を並べる。
     同一カメラで使用時刻が重なる行は色を変え、行頭に×を表示する(その計画は開始できない)。
     予約表は撮影計画の作成/更新時にファイル(camReserve.json)へ作り直す(終了が過去の物は除く)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageView android:id="@+id/reserve_back" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_back_r" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="カメラ予約表" android:textColor="#FFFFFF"
            android:textSize="20sp" android:textStyle="bold" />
        <!-- 右上のメニューは廃止(2026-08-29 UI依頼)。題が中央に見えるよう幅だけ残す -->
        <View android:layout_width="32dp" android:layout_height="32dp" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:textSize="12sp" android:textColor="#666666"
        android:text="撮影終了が未来の計画だけを、カメラごとに表示します。使用時刻が重なる計画は ✕ 印で示し、開始できません。" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:id="@+id/reserve_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>
</LinearLayout>
