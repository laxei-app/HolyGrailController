<?xml version="1.0" encoding="utf-8"?>
<!-- 622.カメラ追加リスト(マスタ)。チェックして複数まとめて所持カメラへ追加する。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageView android:id="@+id/cameraadd_home" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_home_r" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="カメラ追加" android:textColor="#FFFFFF"
            android:textSize="20sp" android:textStyle="bold" />
        <ImageView android:id="@+id/cameraadd_menu" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_menu_r" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:textSize="12sp" android:textColor="#888888"
        android:text="チェックして画面を離れると追加されます。" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/cameraadd_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp" />
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton android:id="@+id/cameraadd_cancel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:layout_margin="12dp"
        android:text="変更の取り消し" android:textColor="#FFFFFF" android:textAllCaps="false"
        android:background="@drawable/btn_cancel_double"
        android:paddingLeft="20dp" android:paddingRight="20dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" />
</LinearLayout>
