<?xml version="1.0" encoding="utf-8"?>
<!-- 660.操作履歴(項目9)。撮影に関する操作を日時とともに記録して見せる(最新が一番上)。
     記録はスマホに保存する。エッジ端末側の操作は進捗ポーリングで得た状態の変化から拾う。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/tc_header_bg"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageView android:id="@+id/history_home" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_home_r" />
        <!-- 戻る(1つ前の画面へ。端末の戻るキーと同じ。2026-09-21 UI依頼で復活) -->
        <ImageView android:id="@+id/history_back" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_marginStart="8dp" android:clickable="true" android:focusable="true" android:src="@drawable/ic_back_r" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="@string/menu_history" android:textColor="@color/tc_header_fg"
            android:textSize="20sp" android:textStyle="bold" />
        <View android:layout_width="40dp" android:layout_height="32dp" />
        <ImageView android:id="@+id/history_menu" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_menu_r" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="@color/tc_text_mid"
            android:text="@string/hist_header" />
        <Button android:id="@+id/history_clear" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/hist_clear" android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:id="@+id/history_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>
</LinearLayout>
