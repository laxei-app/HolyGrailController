<?xml version="1.0" encoding="utf-8"?>
<!-- 632.レンズ追加リスト(マスタ)。メーカーごとに分類し▼で開閉、チェックして複数追加する。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageView android:id="@+id/lensadd_back" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="レンズ追加" android:textColor="#FFFFFF"
            android:textSize="20sp" android:textStyle="bold" />
        <ImageView android:id="@+id/lensadd_menu" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_menu" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:textSize="12sp" android:textColor="#888888"
        android:text="チェックして画面を離れると追加されます。" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/lensadd_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp" />
    </ScrollView>

    <Button android:id="@+id/lensadd_cancel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="12dp" android:text="変更の取り消し" />
</LinearLayout>
