<?xml version="1.0" encoding="utf-8"?>
<!-- 632.レンズ追加リスト(マスタ)。メーカーごとに分類し▼で開閉、チェックして複数追加する。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/tc_header_bg"
        android:gravity="center_vertical"
        android:padding="8dp">
        <ImageView android:id="@+id/lensadd_home" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_home_r" />
        <!-- 戻る(1つ前の画面へ。端末の戻るキーと同じ。2026-09-21 UI依頼で復活) -->
        <ImageView android:id="@+id/lensadd_back" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_marginStart="8dp" android:clickable="true" android:focusable="true" android:src="@drawable/ic_back_r" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="@string/title_lens_add" android:textColor="@color/tc_header_fg"
            android:textSize="20sp" android:textStyle="bold" />
        <View android:layout_width="40dp" android:layout_height="32dp" />
        <ImageView android:id="@+id/lensadd_menu" android:layout_width="32dp" android:layout_height="32dp"
            android:clickable="true" android:focusable="true" android:src="@drawable/ic_menu_r" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:textSize="12sp" android:textColor="@color/tc_text_sub"
        android:text="@string/gear_add_note" />

    <!-- 絞り込み(2026-10-04 依頼)。150本をメーカー別に開くのは、
         目的の1本が分かっているときは遠回りになる。スクロールで消えないよう外に置く。
         横向きだと IME が画面を覆い、打ちながら一覧が絞られていくのは見えない。
         flagNoExtractUi で覆わせない手も試したが、こんどは欄そのものが鍵盤の裏へ
         隠れて打っている字も見えなくなった(2026-10-04 実機で比較)。IME の全画面の欄で
         打って「完了」で戻るのが一番読めるので、既定のままにしてある。 -->
    <EditText android:id="@+id/lensadd_search"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
        android:singleLine="true" android:inputType="text"
        android:hint="@string/lens_search_hint" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/lensadd_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp" />
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton android:id="@+id/lensadd_cancel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:layout_margin="12dp"
        android:text="@string/undo_changes" android:textColor="@color/tc_header_fg" android:textAllCaps="false"
        android:background="@drawable/btn_cancel_double"
        android:paddingLeft="20dp" android:paddingRight="20dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" />
</LinearLayout>
