<?xml version="1.0" encoding="utf-8"?>
<!-- 330撮影計画設定 / 430撮影中 / 撮影制御方法初期値 を ViewFlipper で切り替える。 -->
<!-- 【広告の帯は全画面の最下段(2026-09-29 依頼)】19画面は ViewFlipper 1枚の切り替えなので、
     縦並びで包んで下に枠を1つ置けば、全部の画面に一度で効く。
     free 版でだけ中身が入る。撮影中と、広告が取れないときは枠ごと消える(空白を残さない)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<ViewFlipper
    android:id="@+id/flipper"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <include layout="@layout/screen_plan" />
    <include layout="@layout/screen_capturing" />
    <include layout="@layout/screen_ccm_menu" />
    <include layout="@layout/screen_ccm_edit" />
    <include layout="@layout/screen_gear_menu" />
    <include layout="@layout/screen_camera_list" />
    <include layout="@layout/screen_camera_add" />
    <include layout="@layout/screen_lens_list" />
    <include layout="@layout/screen_lens_add" />
    <include layout="@layout/screen_color" />
    <include layout="@layout/screen_smoothing" />
    <include layout="@layout/screen_places" />
    <include layout="@layout/screen_reserve" />
    <include layout="@layout/screen_history" />
    <include layout="@layout/screen_report" />
    <include layout="@layout/screen_edge" />
    <include layout="@layout/screen_debuglog" />
    <include layout="@layout/screen_permcheck" />
    <include layout="@layout/screen_notices" />
    <include layout="@layout/screen_ext" />
</ViewFlipper>

    <!-- 【広告の帯の地色(2026-10-01 依頼)】枠は幅いっぱいに要求しているが、
         出てくる広告の絵が決まった大きさ(320x50 など)だと中央に置かれ、
         両脇が地の色になる。濃いグレーで塗りつぶして**帯として見せる**。 -->
    <FrameLayout android:id="@+id/ad_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tc_ad_band"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone" />

</LinearLayout>
