<?xml version="1.0" encoding="utf-8"?>
<!-- 【開いた箱の輪郭(2026-10-02 ユーザー指示)】ドロップダウンや ⋮ のメニューの地。
     暗いテーマでは地色が画面とほぼ同じになり、影も沈んで**どこからどこまでが箱か
     分からなかった**。地を一段明るく(暗いときは画面より明るい灰)して、さらに枠を引く。
     明るいテーマでは白地のまま、枠が薄く出るだけで見え方は変わらない。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/tc_popup_bg" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="@color/tc_popup_border" />
</shape>
