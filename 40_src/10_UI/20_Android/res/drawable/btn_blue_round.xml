<?xml version="1.0" encoding="utf-8"?>
<!-- 丸みのある青ボタン(2026-08-29 UI依頼)。画面ごとに Button の既定見た目が違って
     見えるのを避けるため、押せるボタンはこの背景に揃える。
     角丸は**高さの半分(完全なピル)**。ファーム書き込み画面の素の Button が
     Material3 の既定でそうなっており、それに合わせている。高さが変わっても
     ピルのままになるよう大きい値を入れる(Android が高さの半分で頭打ちにする)。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_disabled_bg" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0D47A1" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1565C0" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
