<?xml version="1.0" encoding="utf-8"?>
<!-- 変更の取り消しボタン(無効時): グレーの丸ボタン + 白の内側リング(2重)。未変更=押下不可。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#BDBDBD" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="#9E9E9E" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
