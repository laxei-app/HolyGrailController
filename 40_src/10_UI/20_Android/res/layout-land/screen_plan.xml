<?xml version="1.0" encoding="utf-8"?>
<!-- 330 撮影計画設定の【横向き】(2026-08-30 UI依頼)。縦向きは ../layout/screen_plan.xml。
     縦に2分割し、左=計画リスト + 分割バー + 「カメラ」までの項目(下は縦スクロール)、
     右=残りの項目(縦スクロール)。id は縦向きと1つ残らず同じにすること。
     MainActivity は findViewById で引くので、欠けると起動時に落ちる。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ヘッダ(固定)。plan_title にページ番号(例 1/3)を表示する。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- 戻り先が無いため戻るアイコンは廃止(タイトル中央揃え用のスペーサのみ残す) -->
        <Space
            android:layout_width="32dp"
            android:layout_height="32dp" />

        <TextView
            android:id="@+id/plan_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="撮影計画"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/plan_menu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_menu_r" />
    </LinearLayout>

    <!-- 横スライドのページャ。ページ0=下記フォーム、ページ1..=薄明ページ(コードで追加)。 -->
    <app.laxei.holygrail.PlanPager
        android:id="@+id/plan_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ページ0: 左右2列。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- 左列: 計画リスト + 分割バー + 「カメラ」までの項目。 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

            <!-- 撮影計画リスト(先頭ページのみ)。タップで選択、左アイコンで開始/停止、⋮で操作。
                 常に「新規撮影計画」行あり。分割バーで高さを調整できる。 -->
            <ScrollView android:id="@+id/plan_listScroll"
                android:layout_width="match_parent" android:layout_height="120dp">
                <LinearLayout android:id="@+id/plan_listContainer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="4dp" />
            </ScrollView>
            <FrameLayout android:id="@+id/plan_listDivider"
                android:layout_width="match_parent" android:layout_height="26dp"
                android:background="#ECEFF1" android:clickable="true" android:focusable="true">
                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_gravity="center"
                    android:background="@drawable/divider_handle" />
            </FrameLayout>


                <!-- 分割バーを下げたぶん、ここが縦スクロールする。 -->
                <ScrollView
                    android:id="@+id/plan_formScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                <!-- 撮影開始/終了。背景色と余白は付けない(他の項目と地を揃え、上へ詰める)。
                     見出し幅は 96dp 。下の撮影場所/エッジ端末/カメラ/レンズと内容の左端が揃う。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 撮影開始の上の行。左は撮影中の進捗、右は「変更の取り消し」。
                         進捗は出ていないときも場所を残す(visibility は gone にしない)。
                         撮影を始めても下の行が上下に動かないようにするため。 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/plan_captureStatus"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textColor="#D32F2F"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:text="" />
                        <Button android:id="@+id/plan_resetButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="リセット" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="96dp" android:layout_height="wrap_content"
                            android:text="撮影開始" android:textSize="13sp" android:textStyle="bold" />
                        <Button android:id="@+id/plan_startDate" style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="8dp"
                            android:layout_marginStart="0dp"
                            android:drawableStart="@drawable/ic_calendar" android:text="2026-06-11" />
                        <Button android:id="@+id/plan_startTime" style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="8dp"
                            android:drawableStart="@drawable/ic_clock" android:text="00:00" />
                        <!-- 余った幅は右に寄せる(日付と時刻を左へ詰める) -->
                        <View android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView android:layout_width="96dp" android:layout_height="wrap_content"
                            android:text="撮影終了" android:textSize="13sp" android:textStyle="bold" />
                        <Button android:id="@+id/plan_endDate" style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="8dp"
                            android:layout_marginStart="0dp"
                            android:drawableStart="@drawable/ic_calendar" android:text="2026-06-11" />
                        <Button android:id="@+id/plan_endTime" style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="8dp"
                            android:drawableStart="@drawable/ic_clock" android:text="02:00" />
                        <!-- 余った幅は右に寄せる(日付と時刻を左へ詰める) -->
                        <View android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="1dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 撮影場所。見出しの右に内容を並べる(2026-08-23 UI依頼)。
                     見出しとエッジ端末の見出しは幅を揃えて内容の左端を揃える。 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/plan_placeLabel" android:layout_width="96dp"
                        android:layout_height="wrap_content" android:text="撮影場所" android:textStyle="bold"
                        android:clickable="true" android:focusable="true" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/plan_placeText" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="Tokyo" />
                        <TextView android:id="@+id/plan_latlngText" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textSize="13sp" android:text="35.6810, 139.7670" />
                    </LinearLayout>
                </LinearLayout>

                <!-- エッジ端末 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:id="@+id/plan_edgeLabel" android:layout_width="96dp"
                        android:layout_height="wrap_content" android:text="エッジ端末" android:textStyle="bold"
                        android:clickable="true" android:focusable="true" />
                    <Spinner android:id="@+id/plan_edgeSpinner" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- カメラ/レンズ。上の撮影場所/エッジ端末と同じ、見出し 96dp + 内容の並びに揃える。 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal">
                    <TextView android:id="@+id/plan_cameraLabel" android:layout_width="96dp"
                        android:layout_height="wrap_content" android:text="カメラ" android:textStyle="bold"
                        android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/plan_cameraText" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Canon EOS R10" />
                </LinearLayout>

                </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!-- 右列: 残りの項目。 -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                <!-- 同期撮影。上のカメラで測光して決めた露出を追加カメラへも配り、全台で撮る。 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="96dp" android:layout_height="wrap_content"
                        android:text="同期撮影" android:textStyle="bold" android:singleLine="true" />
                    <Switch android:id="@+id/plan_syncShot" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
                <!-- 追加カメラ。同期撮影がONのときだけ出す。タップで複数選択。 -->
                <LinearLayout android:id="@+id/plan_subCamRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView android:id="@+id/plan_subCamLabel" android:layout_width="96dp"
                        android:layout_height="wrap_content" android:text="追加カメラ" android:textStyle="bold"
                        android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/plan_subCamText" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:clickable="true" android:focusable="true" android:text="未選択" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal">
                    <TextView android:id="@+id/plan_lensLabel" android:layout_width="96dp"
                        android:layout_height="wrap_content" android:text="レンズ" android:textStyle="bold"
                        android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/plan_lensText" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="SIGMA 12mm F1.4 DC" />
                </LinearLayout>

                <!-- 撮影周期 / 横向き。上の項目と同じ、見出し 96dp + 内容の並びに揃える。 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="96dp" android:layout_height="wrap_content"
                        android:text="撮影周期" android:textStyle="bold" />
                    <TextView android:id="@+id/plan_intervalText" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:clickable="true" android:focusable="true"
                        android:background="#F0F0F0" android:padding="6dp" android:text="15秒"
                        android:textSize="15sp" android:textStyle="bold" />
                    <!-- NPF シャッター速度(参考表示) / 最小撮影周期。周期を決めるときの目安なので、
                         入力欄の真横に置く(2026-08-24 UI依頼)。 -->
                    <TextView android:id="@+id/plan_npfText" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textSize="12sp" android:textColor="#888888"
                        android:text="NPF -- 秒   最小周期 -- 秒" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="横向きで撮る(ランドスケープ)" android:textStyle="bold"
                        android:singleLine="true" />
                    <Switch android:id="@+id/plan_landscape" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="12dp" />
                </LinearLayout>


                <!-- 概要スケジュール(表示専用。時刻とイベントのみ)。撮影制御方法ボタンの上。 -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="概要スケジュール" android:textStyle="bold" />
                <LinearLayout android:id="@+id/plan_overviewContainer"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:orientation="vertical" />

                <!-- 撮影制御方法の編集ボタン(全種・常に定位置)。詳細な薄明帯は横スライドの薄明ページで編集する。 -->
                <TextView android:id="@+id/plan_ccmEditLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="撮影制御方法（タップで編集）" android:textSize="13sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/plan_ccmButtons"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:orientation="vertical" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </app.laxei.holygrail.PlanPager>
</LinearLayout>
